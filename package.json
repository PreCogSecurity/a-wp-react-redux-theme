{
  "name": "a-wp-react-redux-theme",
  "version": "1.0.0",
  "private": true,
  "description": "WordPress theme that renders its front end with React + Redux on top of the WP REST API.",
  "main": "src/index.js",
  "scripts": {
    "build": "webpack",
    "prod": "webpack -p",
    "watch": "webpack --env.development --watch",
    "lint": "eslint src webpack.config.js --ext .js --max-warnings=0",
    "lint:fix": "eslint src webpack.config.js --ext .js --fix",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "verify": "npm run lint && npm test"
  },
  "keywords": [
    "wordpress",
    "wordpress-theme",
    "react",
    "redux",
    "wp-rest-api"
  ],
  "author": "jackreichert",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PreCogSecurity/a-wp-react-redux-theme.git"
  },
  "bugs": {
    "url": "https://github.com/PreCogSecurity/a-wp-react-redux-theme/issues"
  },
  "homepage": "https://github.com/PreCogSecurity/a-wp-react-redux-theme#readme",
  "engines": {
    "node": ">=8.0.0 <17.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "autoprefixer": "^7.1",
    "axios": "^1.7.7",
    "babel-core": "^6.26",
    "babel-loader": "^7.1",
    "babel-polyfill": "^6.26",
    "babel-preset-env": "^1.6",
    "babel-preset-minify": "^0.2",
    "babel-preset-react": "^6.24",
    "babel-preset-stage-2": "^6.24",
    "caniuse-lite": "^1.0",
    "connected-react-router": "^4.3",
    "css-loader": "^0.28",
    "extract-text-webpack-plugin": "^3.0",
    "history": "^4.6",
    "node-sass": "^4.7",
    "postcss-loader": "^2.0",
    "react": "^16.2",
    "react-addons-css-transition-group": "^15.6",
    "react-dom": "^16.2",
    "react-redux": "^5.0",
    "react-router": "^4.2",
    "react-router-dom": "^4.2",
    "redux": "^3.7",
    "redux-logger": "^3.0",
    "redux-promise-middleware": "^5.0",
    "redux-thunk": "^2.2",
    "sass-loader": "^6.0",
    "webpack": "^3.10"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/setup.js"
    ],
    "collectCoverageFrom": [
      "src/actions/**/*.js",
      "src/reducers/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 75,
        "functions": 80,
        "lines": 80
      }
    },
    "coverageReporters": [
      "text-summary",
      "lcov"
    ]
  }
}
