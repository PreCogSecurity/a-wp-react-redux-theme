{
  "root": true,
  "env": {
    "browser": true,
    "es6": true,
    "node": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "globals": {
    "RT_API": "readonly"
  },
  "extends": "eslint:recommended",
  "ignorePatterns": [
    "node_modules/",
    "bundle.js",
    "bundle.css",
    "coverage/"
  ],
  "rules": {
    "no-console": ["error", {"allow": ["warn", "error"]}],
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": ["error", {
      "args": "after-used",
      "varsIgnorePattern": "^[A-Z]"
    }]
  }
}
