# `react-addons-css-transition-group@15` is the final React 15 release of the
# deprecated addons shim. It declares `peerDependencies: {react: "^15.4.2"}` even
# though it still runs correctly against React 16 (the project imports React 16).
# npm >= 7 refuses to build an ideal tree for that combination, so the whole
# install - and therefore `npm ci` in CI - would fail with ERESOLVE.
#
# `legacy-peer-deps=true` keeps peer resolution permissive (identical to the npm
# 6 behaviour this project was written against) without relaxing lockfile
# integrity or skipping `npm audit`. See CONTRIBUTING.md for the upgrade path.
legacy-peer-deps=true
